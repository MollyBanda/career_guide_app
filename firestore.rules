rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: verifies that the requesting user has the custom claim 'admin: true'
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper function: verifies that the requesting user is accessing their own user document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profiles & account data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Private user subcollections (saved items, assessment history, recommendations)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Shared educational catalogue collection (Careers, Universities, Scholarships, Training, Internships, Assessment)
    match /opportunities/{opportunityId} {
      allow read: if true; // Public read access for students & anonymous visitors
      allow create, update, delete: if isAdmin(); // Strictly restricted to verified admins with custom claims
    }

    // Shared university programmes collection
    match /university_programmes/{programmeId} {
      allow read: if true; // Public read access for students
      allow create, update, delete: if isAdmin(); // Strictly restricted to verified admins with custom claims
    }

    // System broadcast announcements collection
    match /announcements/{announcementId} {
      allow read: if true; // Public read access for students
      allow create, update, delete: if isAdmin(); // Strictly restricted to verified admins with custom claims
    }
  }
}
